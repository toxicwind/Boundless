  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "fast-xml-parser": "^4.5.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "semantic-release": "^25.0.9"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": []
