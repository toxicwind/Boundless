{
  "name": "boundless",
  "version": "2.0.0",
  "description": "boundless — sovereign maximal document splitter (Bun-native, 50MB Natural Reader)",
  "private": true,
  "type": "module",
  "main": "web/server.ts",
  "scripts": {
    "dev": "bun run --hot web/server.ts",
